    <style>
        /* ==========================================================
           TOKENS
           Slate-night palette (Derbyshire grey skies after dark),
           notification red for anything you can act on,
           message-bubble green used only inside the chat UI.
           ========================================================== */
        :root {
            --night: #12161B;
            --band: #171C22;
            --slate: #1D232B;
            --rule: #2C343E;
            --mist: #ECEAE5;
            --mist-soft: #D2D0CA;
            --fog: #A3ACB6;
            --fog-dim: #7E8893;
            --signal: #D62C2B;
            --signal-hover: #B92221;
            --signal-text: #FF6B63;
            --bubble-in: #262D36;
            --bubble-out: #3CC47F;
            --bubble-out-text: #06140C;

            --font-display: "Archivo", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
            --font-text: "Literata", Georgia, "Times New Roman", serif;

            --container: 1180px;
            --gutter: clamp(1.25rem, 4.5vw, 2.5rem);
            --header-h: 64px;
            --section-space: clamp(4.5rem, 11vw, 8.5rem);
        }

        @media (min-width: 1024px) {
            :root { --header-h: 76px; }
        }

        /* ==========================================================
           BASE
           ========================================================== */
        *, *::before, *::after { box-sizing: border-box; }

        html {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
            scroll-padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 12px);
        }

        @media (prefers-reduced-motion: no-preference) {
            html { scroll-behavior: smooth; }
        }

        body {
            margin: 0;
            background: var(--night);
            color: var(--mist);
            font-family: var(--font-text);
            font-size: 1.0625rem;
            line-height: 1.7;
            font-optical-sizing: auto;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
        }

        @media (min-width: 1024px) {
            body { font-size: 1.125rem; }
        }

        body.menu-open { overflow: hidden; }

        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; }
        p { margin: 0; }

        h1, h2, h3 {
            margin: 0;
            font-family: var(--font-display);
            font-weight: 760;
            font-stretch: 72%;
            line-height: 1;
            letter-spacing: -0.005em;
            text-wrap: balance;
        }

        :focus-visible {
            outline: 2px solid var(--signal-text);
            outline-offset: 3px;
            border-radius: 2px;
        }

        ::selection { background: var(--signal); color: #fff; }

        .sr-only {
            position: absolute !important;
            width: 1px; height: 1px;
            padding: 0; margin: -1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
            border: 0;
        }

        .container {
            width: 100%;
            max-width: var(--container);
            margin-inline: auto;
            padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
            padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
        }

        .skip-link {
            position: fixed;
            top: 0.75rem;
            left: 0.75rem;
            z-index: 200;
            padding: 0.7rem 1rem;
            background: var(--mist);
            color: var(--night);
            font-family: var(--font-display);
            font-weight: 650;
            text-decoration: none;
            border-radius: 4px;
            transform: translateY(-160%);
        }
        .skip-link:focus { transform: none; }

        .section-title { font-size: clamp(2.4rem, 7vw, 3.75rem); }

        .section-lede {
            margin-top: 1rem;
            max-width: 34em;
            color: var(--fog);
        }

        /* ==========================================================
           BUTTONS & LINKS
           ========================================================== */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 50px;
            padding: 0.8rem 1.5rem;
            border: 1px solid transparent;
            border-radius: 4px;
            font-family: var(--font-display);
            font-size: 1.02rem;
            font-weight: 650;
            font-stretch: 90%;
            line-height: 1.2;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        .btn-primary { background: var(--signal); color: #fff; }
        .btn-primary:hover { background: var(--signal-hover); }

        .btn-ghost { border-color: var(--rule); color: var(--mist); background: transparent; }
        .btn-ghost:hover { border-color: var(--fog); }

        .btn-small { min-height: 42px; padding: 0.55rem 1.1rem; font-size: 0.95rem; }

        .text-link {
            display: inline-block;
            padding-block: 0.35rem;
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 650;
            color: var(--signal-text);
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 0.28em;
        }
        .text-link:hover { color: var(--mist); }

        /* ==========================================================
           HEADER & NAVIGATION
           ========================================================== */
        .site-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            padding-top: env(safe-area-inset-top, 0px);
            border-bottom: 1px solid transparent;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        .site-header.is-scrolled,
        .site-header.menu-active {
            background: rgba(18, 22, 27, 0.92);
            -webkit-backdrop-filter: blur(16px) saturate(140%);
            backdrop-filter: blur(16px) saturate(140%);
            border-bottom-color: var(--rule);
        }

        .header-inner {
            height: var(--header-h);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .wordmark {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 760;
            font-stretch: 74%;
            letter-spacing: 0.01em;
            color: var(--mist);
            text-decoration: none;
            white-space: nowrap;
        }

        .site-nav { display: none; }

        .nav-list {
            display: flex;
            gap: 1.9rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .nav-list a {
            position: relative;
            display: inline-block;
            padding: 0.5rem 0;
            font-family: var(--font-display);
            font-size: 0.98rem;
            font-weight: 550;
            color: var(--fog);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .nav-list a:hover,
        .nav-list a[aria-current="true"] { color: var(--mist); }

        .nav-list a::after {
            content: "";
            position: absolute;
            left: 0; right: 0; bottom: 0.15rem;
            height: 2px;
            background: var(--signal);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.25s ease;
        }
        .nav-list a[aria-current="true"]::after { transform: scaleX(1); }

        .menu-toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            min-height: 44px;
            margin-right: -0.4rem;
            padding: 0 0.4rem 0 0.8rem;
            background: none;
            border: 0;
            color: var(--mist);
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .menu-toggle-lines {
            position: relative;
            width: 22px;
            height: 14px;
        }

        .menu-toggle-lines::before,
        .menu-toggle-lines::after {
            content: "";
            position: absolute;
            left: 0; right: 0;
            height: 2px;
            border-radius: 2px;
            background: currentColor;
            transition: transform 0.25s ease, top 0.25s ease;
        }
        .menu-toggle-lines::before { top: 2px; }
        .menu-toggle-lines::after { top: 10px; }

        .menu-toggle[aria-expanded="true"] .menu-toggle-lines::before { top: 6px; transform: rotate(45deg); }
        .menu-toggle[aria-expanded="true"] .menu-toggle-lines::after { top: 6px; transform: rotate(-45deg); }

        /* Full-screen mobile menu */
        .mobile-menu {
            position: fixed;
            inset: 0;
            z-index: 90;
            display: flex;
            flex-direction: column;
            gap: 2rem;
            padding: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 1.25rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom, 0px));
            overflow-y: auto;
            overscroll-behavior: contain;
            background: var(--night);
            visibility: hidden;
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
        }

        .mobile-menu.is-open {
            visibility: visible;
            opacity: 1;
            transform: none;
            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s;
        }

        .mobile-menu-list {
            margin: 0;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--rule);
        }

        .mobile-menu-list a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
            border-bottom: 1px solid var(--rule);
            font-family: var(--font-display);
            font-size: 2.25rem;
            font-weight: 740;
            font-stretch: 68%;
            line-height: 1.1;
            color: var(--mist);
            text-decoration: none;
        }

        .mobile-menu-list a[aria-current="true"] { color: var(--signal-text); }

        .mobile-menu-social {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1.5rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .mobile-menu-social a {
            display: inline-block;
            padding: 0.6rem 0;
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--fog);
            text-decoration: none;
        }

        @media (min-width: 1024px) {
            .site-nav { display: flex; align-items: center; gap: 2.25rem; }
            .menu-toggle, .mobile-menu { display: none; }
        }

        /* ==========================================================
           HERO — The Group Chat
           ========================================================== */
        .hero {
            position: relative;
            overflow: hidden;
            padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(1.75rem, 5vw, 4.5rem));
            padding-bottom: var(--section-space);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "tag"
                "title"
                "visual"
                "blurb"
                "actions";
        }

        .release-tag {
            grid-area: tag;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 1rem;
            font-family: var(--font-display);
            font-size: 0.98rem;
            font-weight: 600;
            color: var(--fog);
        }

        .release-tag .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--signal-text);
            box-shadow: 0 0 0 4px rgba(255, 107, 99, 0.16);
        }

        .hero-title {
            grid-area: title;
            font-size: clamp(3.9rem, 17vw, 9.5rem);
            font-weight: 800;
            font-stretch: 62%;
            line-height: 0.88;
            letter-spacing: -0.01em;
        }
        .hero-title span { display: block; }

        .hero-visual {
            grid-area: visual;
            position: relative;
            isolation: isolate;
            justify-self: center;
            width: min(50vw, 230px);
            margin: 1.75rem 0 1.75rem;
        }

        /* Faint screen-light glow behind the cover */
        .hero-visual::before {
            content: "";
            position: absolute;
            inset: -30% -55%;
            z-index: -1;
            background: radial-gradient(closest-side, rgba(150, 175, 210, 0.17), rgba(150, 175, 210, 0));
            pointer-events: none;
        }

        .hero-blurb {
            grid-area: blurb;
            max-width: 30em;
            font-size: 1.125rem;
            line-height: 1.65;
            color: var(--mist-soft);
        }

        .hero-actions {
            grid-area: actions;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 1.75rem;
        }

        @media (min-width: 600px) {
            .hero-actions { flex-direction: row; flex-wrap: wrap; }
            .hero-visual { width: min(46vw, 300px); }
        }

        @media (min-width: 1024px) {
            .hero-grid {
                grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
                grid-template-rows: 1fr auto auto auto auto 1fr;
                grid-template-areas:
                    ".       visual"
                    "tag     visual"
                    "title   visual"
                    "blurb   visual"
                    "actions visual"
                    ".       visual";
                column-gap: 4rem;
            }
            .hero-visual { width: min(100%, 360px); margin: 0; }
            .hero-blurb { margin-top: 2rem; font-size: 1.22rem; }
            .hero-actions { margin-top: 2.25rem; }
        }

        /* Book covers (shared) */
        .cover-link {
            display: block;
            border-radius: 4px;
            text-decoration: none;
        }

        .cover {
            position: relative;
            display: block;
            overflow: hidden;
            border-radius: 2px 5px 5px 2px;
            background: var(--slate);
            box-shadow:
                0 2px 3px rgba(0, 0, 0, 0.35),
                0 24px 48px -18px rgba(0, 0, 0, 0.85);
            transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.35s ease;
        }

        .cover img { width: 100%; }

        /* Spine crease so flat JPGs read as physical books */
        .cover::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(90deg,
                rgba(0, 0, 0, 0.38) 0%,
                rgba(255, 255, 255, 0.14) 1.4%,
                rgba(255, 255, 255, 0) 3.2%,
                rgba(0, 0, 0, 0.10) 4.6%,
                rgba(0, 0, 0, 0) 9%);
        }

        @media (hover: hover) {
            .cover-link:hover .cover {
                transform: translateY(-5px);
                box-shadow:
                    0 2px 3px rgba(0, 0, 0, 0.35),
                    0 34px 60px -20px rgba(0, 0, 0, 0.9);
            }
        }

        /* Lock-screen notification over the hero cover */
        .notification {
            position: absolute;
            z-index: 2;
            top: 7%;
            left: 50%;
            width: min(max(114%, 17.5rem), 24rem, calc(100vw - 2.5rem));
            transform: translateX(-50%);
            display: flex;
            align-items: flex-start;
            gap: 0.7rem;
            padding: 0.7rem 0.85rem;
            border-radius: 18px;
            background: rgba(38, 43, 51, 0.8);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            backdrop-filter: blur(18px) saturate(160%);
            box-shadow: 0 14px 32px -10px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
            font-family: var(--font-display);
            line-height: 1.3;
            color: var(--mist);
            text-align: left;
        }

        .js .notification {
            opacity: 0;
            animation: notifIn 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.15) 0.9s forwards;
        }

        @keyframes notifIn {
            from { opacity: 0; transform: translate(-50%, -14px) scale(0.96); }
            to   { opacity: 1; transform: translate(-50%, 0) scale(1); }
        }

        .notif-icon {
            flex: none;
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--bubble-out);
            color: #fff;
        }
        .notif-icon svg { width: 20px; height: 20px; }

        .notif-body { display: block; flex: 1; min-width: 0; }

        .notif-top {
            display: flex;
            justify-content: space-between;
            gap: 0.5rem;
            font-size: 0.82rem;
        }
        .notif-top strong { font-weight: 650; }
        .notif-top span { color: var(--fog); }

        .notif-text {
            display: block;
            margin-top: 0.1rem;
            font-size: 0.9rem;
            color: var(--mist-soft);
        }

        /* ==========================================================
           TEASER — the chat itself
           ========================================================== */
        .teaser {
            padding-block: var(--section-space);
            border-top: 1px solid var(--rule);
        }

        .teaser-grid {
            display: grid;
            gap: 3rem;
            align-items: center;
        }

        .teaser-copy p {
            max-width: 28em;
            margin-top: 1.1rem;
            font-size: 1.15rem;
            color: var(--fog);
        }

        .teaser-copy .btn { margin-top: 1.9rem; }

        .phone {
            width: 100%;
            max-width: 400px;
            margin: 0;
        }

        .thread {
            overflow: hidden;
            border: 1px solid var(--rule);
            border-radius: 22px;
            background: #0E1115;
        }

        .thread-head {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1rem;
            border-bottom: 1px solid var(--rule);
            background: var(--slate);
        }

        .thread-avatar {
            flex: none;
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #39414C;
            font-family: var(--font-display);
            font-size: 1.1rem;
            font-weight: 700;
        }

        .thread-meta { display: block; font-family: var(--font-display); line-height: 1.3; }
        .thread-meta strong { display: block; font-size: 1rem; font-weight: 650; }
        .thread-meta span { display: block; font-size: 0.8rem; color: var(--fog); }

        .thread-body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 1.1rem 0.9rem 1.25rem;
        }

        .msg {
            max-width: 82%;
            padding: 0.6rem 0.9rem;
            border-radius: 18px;
            font-family: var(--font-display);
            font-size: 0.95rem;
            line-height: 1.38;
        }

        .msg-in {
            align-self: flex-start;
            background: var(--bubble-in);
            border-bottom-left-radius: 6px;
        }

        .msg-out {
            align-self: flex-end;
            background: var(--bubble-out);
            color: var(--bubble-out-text);
            border-bottom-right-radius: 6px;
        }

        .msg-system {
            align-self: center;
            max-width: none;
            padding: 0.2rem 0 0.4rem;
            font-size: 0.78rem;
            color: var(--fog-dim);
        }

        .sender {
            display: block;
            margin-bottom: 0.2rem;
            font-size: 0.76rem;
            font-weight: 650;
            color: var(--signal-text);
        }

        .msg-video { padding: 0.5rem; }
        .msg-video .sender { padding: 0.1rem 0.4rem 0; }

        .video-tile {
            display: grid;
            place-items: center;
            width: min(190px, 52vw);
            aspect-ratio: 16 / 10;
            border-radius: 13px;
            background:
                radial-gradient(ellipse at 30% 30%, rgba(255, 255, 255, 0.06), transparent 60%),
                linear-gradient(160deg, #2A3038, #0A0C0F);
        }
        .video-tile svg { width: 44px; height: 44px; }

        .msg-threat {
            border: 1px solid rgba(255, 107, 99, 0.45);
            background: rgba(214, 44, 43, 0.12);
        }

        .typing {
            align-self: flex-start;
            display: flex;
            gap: 4px;
            padding: 0.85rem 1rem;
            border-radius: 18px;
            border-bottom-left-radius: 6px;
            background: var(--bubble-in);
        }

        .typing span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--fog);
            opacity: 0.4;
            animation: typing 1.4s ease-in-out infinite;
        }
        .typing span:nth-child(2) { animation-delay: 0.2s; }
